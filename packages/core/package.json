{
  "name": "@tautest/core",
  "version": "2.0.5",
  "description": "Core engine for Tautest, a PR-focused mutation testing workflow layer on top of StrykerJS",
  "license": "MIT",
  "author": "Tautest contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mutation-testing",
    "stryker",
    "changed-lines",
    "test-quality",
    "github-action",
    "ai-assisted-testing",
    "vitest",
    "jest",
    "testing",
    "ai"
  ],
  "homepage": "https://github.com/canblmz1/tautest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canblmz1/tautest.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/canblmz1/tautest/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "json5": "^2.2.3",
    "tinyglobby": "^0.2.16",
    "yaml": "^2.9.0",
    "zod": "^3.24.4"
  },
  "peerDependencies": {
    "@stryker-mutator/api": "^9.6.1 || ^10.0.0",
    "@stryker-mutator/core": "^9.6.1 || ^10.0.0",
    "@stryker-mutator/jest-runner": "^9.6.1 || ^10.0.0",
    "@stryker-mutator/vitest-runner": "^9.6.1 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@stryker-mutator/jest-runner": {
      "optional": true
    },
    "@stryker-mutator/vitest-runner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.15.17",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
