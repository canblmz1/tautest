{
  "name": "@tautest/github-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action for running Tautest on pull requests",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --sourcemap --packages=bundle",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
