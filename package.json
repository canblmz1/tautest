{
  "name": "tautest-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "coverage": "pnpm -r --if-present test:coverage",
    "lint": "pnpm -r --if-present lint",
    "release": "changeset publish",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:example": "vitest run --config examples/vitest-basic/vitest.config.ts",
    "prototype": "tsx scripts/prototype-run.ts",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.15.2"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^3.2.4",
    "tautest": "workspace:*",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
