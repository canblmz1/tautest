{
  "name": "tautest-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:example": "vitest run --config examples/vitest-basic/vitest.config.ts",
    "prototype": "tsx scripts/prototype-run.ts"
  },
  "devDependencies": {
    "tautest": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
